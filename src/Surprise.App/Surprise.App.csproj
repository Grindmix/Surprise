<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.31</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Surprise</AssemblyName><ApplicationManifest>../app.manifest</ApplicationManifest>
    <MpvArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</MpvArchitecture>
    <MpvArchitecture Condition="'$(MpvArchitecture)' == ''">x64</MpvArchitecture>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Surprise.Windows/Surprise.Windows.csproj" />
    <Compile Include="../Surprise.Executor/MpvSession.cs" Link="Playback/MpvSession.cs" />
    <Compile Include="../Surprise.Executor/MpvBundle.cs" Link="Playback/MpvBundle.cs" />
    <Compile Include="../Surprise.Executor/ChildProcessJob.cs" Link="Playback/ChildProcessJob.cs" />
    <Compile Include="../Surprise.Executor/PlaybackWindow.cs" Link="Playback/PlaybackWindow.cs" />
    <EmbeddedResource Include="../../artifacts/vendor/mpv/$(MpvArchitecture)/mpv.exe" LogicalName="Surprise.mpv.exe" />
    <EmbeddedResource Include="../../artifacts/vendor/mpv/$(MpvArchitecture)/mpv.sha256" LogicalName="Surprise.mpv.sha256" />
    <EmbeddedResource Include="../../THIRD-PARTY.txt" LogicalName="Surprise.THIRD-PARTY.txt" />
  </ItemGroup>
</Project>
